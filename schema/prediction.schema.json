{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dz9oo/banc-rgaa/schema/prediction.schema.json",
  "title": "Prédiction",
  "type": "object",
  "additionalProperties": false,
  "required": ["outil", "date", "predictions"],
  "properties": {
    "outil": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cas"],
        "properties": {
          "cas": { "type": "string" },
          "verdict": { "enum": ["conforme", "non_conforme", "non_applicable", "non_tranche"] }
        }
      }
    }
  }
}
